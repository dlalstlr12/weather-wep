# 복사해서 .env로 사용하세요. 실제 값은 커밋하지 마세요.
# 아래 값은 필수이며, 설정되지 않으면 백엔드가 기동 시 실패합니다.
JWT_SECRET=replace-with-a-random-string-of-32-chars-or-more
SPRING_DATASOURCE_USERNAME=weather
SPRING_DATASOURCE_PASSWORD=replace-me

# docker-compose의 PostgreSQL(PostGIS) 컨테이너 설정 (SPRING_DATASOURCE_*와 같은 값을 쓴다)
POSTGRES_USER=weather
POSTGRES_PASSWORD=replace-me

# 기상청 API 키 (공공데이터포털 또는 기상청 API Hub)
KMA_SERVICE_KEY=

# Anthropic API 키 (챗 LLM). 콘솔에서 발급하고 월 지출 한도를 설정한다
ANTHROPIC_API_KEY=
